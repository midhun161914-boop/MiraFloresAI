# All optional. Defaults work for local development.

# Canonical, read-only packet (defaults to the file at the project root)
# PACKET_PATH=./okafor_lindqvist_2025_packet.json

# Where the packet is staged (copied + hashed) before loading
# DATA_DIR=./data

# Which engine version the workpaper treats as current
# CURRENT_VERSION=v3

# API port used by `npm run dev` / `npm start`
# API_PORT=8000
